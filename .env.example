# Server Port (defaults to 3000)
PORT=3000

# Optional default provider priority when Smart Auto is selected:
# auto | openai | gemini | groq | openrouter | mistral | custom
AI_DEFAULT_PROVIDER=

# OpenAI / ChatGPT (recommended if using an existing OpenAI key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (standard public Gemini API key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional additional AI providers (preserve multi-provider support)
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Optional Self-Hosted / Local Ollama / LM Studio endpoint
AI_CUSTOM_BASE_URL=
AI_CUSTOM_MODEL=
AI_CUSTOM_API_KEY=